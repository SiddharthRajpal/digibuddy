# Copy to backend/.env for local development (docker compose sets these itself).
DATABASE_URL=postgresql+asyncpg://digibuddy:digibuddy@localhost:5432/digibuddy
# Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32b
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
AUTH_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=120
TRUST_FORWARDED_FOR=true
MODEL_ARTIFACT_DIR=./model_artifacts
ENABLE_SCHEDULER=true
NIGHTLY_HOUR_LOCAL=3
LOG_LEVEL=INFO

# Prediction engine
RECENCY_HALF_LIFE_DAYS=60
BASELINE_HALF_LIFE_DAYS=3
BACKTEST_MAX_DAYS=30
BACKTEST_FRACTION=0.25
INTERVAL_COVERAGE=0.8
PROMOTION_MIN_IMPROVEMENT=0.02
GAP_REVERT_DAYS=3
USE_LIGHTGBM=true
DEFAULT_SUPPORT_REGION=INTL
